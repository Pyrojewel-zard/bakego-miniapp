.tabbar {
  position: fixed;
  z-index: 1000;
  left: 0; right: 0; bottom: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255,255,255,.98);
  border-top: 1rpx solid #ededed;
  display: flex;
  align-items: center;
}
.tab-item { width: 20%; height: 112rpx; display: flex; justify-content: center; align-items: center; }
.normal-item { color: #c4c4c4; font-size: 22rpx; text-align: center; line-height: 1.2; }
.normal-item.selected { color: #111; }
.icon { font-size: 42rpx; height: 52rpx; line-height: 52rpx; font-weight: 700; }
.label { margin-top: 4rpx; }
.center-wrap { position: relative; }
.center-button {
  width: 108rpx; height: 108rpx;
  margin-top: -52rpx;
  border-radius: 54rpx;
  background: #d8d8d8;
  border: 8rpx solid #f7f7f7;
  box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.center-icon {
  width: 64rpx; height: 64rpx; border-radius: 18rpx;
  background: #3c3c3c; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}

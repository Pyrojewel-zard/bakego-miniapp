.member{min-height:100vh;background:#00875f;padding:0 18rpx 80rpx;box-sizing:border-box}.member-topbar{height:120rpx;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 18rpx;font-size:40rpx}.member-topbar .title{font-size:34rpx;font-weight:700}.member-card{position:relative;background:#fff;border-radius:22rpx;min-height:1080rpx;padding:105rpx 25rpx 30rpx;box-sizing:border-box;text-align:center;margin-top:30rpx}.mavatar{position:absolute;top:-58rpx;left:50%;margin-left:-58rpx;width:116rpx;height:116rpx;border-radius:50%;background:#fff;border:4rpx solid #fff}.username{font-size:32rpx;color:#444;margin-bottom:55rpx}.barcode{height:205rpx;display:flex;align-items:stretch;justify-content:center;padding:0 40rpx;box-sizing:border-box;overflow:hidden}.bar{height:100%;background:#000;flex:none}.qr{width:360rpx;height:360rpx;margin:30rpx auto 35rpx;display:flex;flex-wrap:wrap;background:#fff;border:16rpx solid #fff;box-shadow:0 0 0 1rpx #eee}.qcell{background:#fff;width:calc(100% / 21);height:calc(100% / 21);box-sizing:border-box}.qcell.dark{background:#000}.refresh{font-size:22rpx;color:#aaa}.divider{height:1rpx;background:#eee;margin:34rpx 0}.stats{display:flex;justify-content:space-around;color:#777}.num{font-size:32rpx;color:#00875f;margin-bottom:10rpx}
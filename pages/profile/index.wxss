.profile{background:#f7f7f7;min-height:100vh}.nav{height:118rpx;padding-top:40rpx;box-sizing:border-box;text-align:center;background:#fff;font-size:34rpx;font-weight:700}.dark{height:420rpx;background:linear-gradient(135deg,#2f3239,#13161b);padding:135rpx 24rpx 0;box-sizing:border-box;position:relative;overflow:hidden}.facet{position:absolute;background:rgba(255,255,255,.04);transform:rotate(28deg)}.f1{width:430rpx;height:220rpx;left:-80rpx;top:22rpx}.f2{width:430rpx;height:260rpx;right:-120rpx;top:20rpx}.f3{width:500rpx;height:180rpx;left:180rpx;bottom:20rpx;background:rgba(255,255,255,.025)}.user{display:flex;align-items:center;color:#fff;position:relative;z-index:2}.avatar{width:110rpx;height:110rpx;border-radius:50%;background:#fff;margin-right:26rpx;border:2rpx solid rgba(255,255,255,.8)}.uinfo{flex:1;font-size:24rpx}.uname{font-size:34rpx;font-weight:700;margin-bottom:10rpx}.login{margin:0;background:#00875f;color:#fff;border-radius:40rpx;font-size:26rpx;padding:0 30rpx;height:64rpx;line-height:64rpx;white-space:nowrap}.login.done{display:flex;align-items:center;padding:0 28rpx;opacity:.86}.assets{margin:-82rpx 18rpx 20rpx;padding:28rpx;position:relative}.section-title{font-size:31rpx;font-weight:700;margin-bottom:30rpx}.asset-row{display:flex;justify-content:space-between;text-align:center}.asset-cell{width:33.333%}.a-main{font-size:30rpx;font-weight:700}.a-main text{margin-left:8rpx}.sub{font-size:22rpx;color:#aaa;margin-top:12rpx}.sub text{color:#e44}.orders{margin:0 18rpx;padding:28rpx;height:185rpx;box-sizing:border-box}.order-entry{width:130rpx;text-align:center}.entry-icon{font-size:46rpx;margin-bottom:12rpx}.tools{background:#fff;margin-top:20rpx;display:flex;flex-wrap:wrap;padding:42rpx 0 16rpx}.tool{width:25%;text-align:center;margin-bottom:44rpx}.ti{font-size:48rpx;margin-bottom:14rpx}.promo{margin:20rpx 18rpx 0;height:150rpx;border-radius:14rpx;background:#dcf63e;color:#329742;font-size:52rpx;font-weight:900;display:flex;align-items:center;justify-content:center;overflow:hidden}.promo-icon{font-size:72rpx;margin-right:16rpx}.promo text{display:block;font-size:23rpx;line-height:1.1}.dev-badge{width:max-content;margin:18rpx auto 150rpx;padding:8rpx 18rpx;border-radius:20rpx;background:#ececec;color:#9b9b9b;font-size:20rpx}
.home { background: #7d84c6; }
.hero { height: 470rpx; position: relative; overflow: hidden; }
.hero-deco { position:absolute; font-size:120rpx; top:70rpx; opacity:.95; }
.hero-deco.left { left:155rpx; transform: rotate(-15deg); }
.hero-deco.right { right:155rpx; transform: rotate(15deg); }
.mascot { position:absolute; width:470rpx; height:350rpx; left:140rpx; bottom:-15rpx; }
.ear { position:absolute; width:105rpx; height:210rpx; background:#fffdf8; border:4rpx solid #9d826c; border-radius:70% 70% 20% 20%; top:0; z-index:0; }
.e1 { left:95rpx; transform:rotate(-7deg); } .e2 { right:95rpx; transform:rotate(7deg); }
.face { position:absolute; width:470rpx; height:285rpx; bottom:0; background:#fffdf8; border:4rpx solid #9d826c; border-radius:52% 52% 20% 20%; z-index:1; }
.eye { position:absolute; width:8rpx; height:12rpx; border-radius:50%; background:#9b7b67; top:125rpx; }
.eye.l{left:185rpx}.eye.r{right:185rpx}.nose{position:absolute;width:7rpx;height:32rpx;background:#9b7b67;left:231rpx;top:135rpx;border-radius:10rpx}
.cheek{position:absolute;width:52rpx;height:24rpx;border-radius:50%;background:#f8d9da;top:150rpx}.c1{left:95rpx}.c2{right:95rpx}
.cream { background:#fff1df; min-height:760rpx; padding:60rpx 28rpx 180rpx; border-radius:50% 50% 0 0 / 70rpx 70rpx 0 0; margin-top:-20rpx; }
.actions { display:flex; justify-content:space-around; margin-top:-20rpx; }
.action { width:30%; text-align:center; color:#5860a5; font-weight:700; font-size:34rpx; }
.round { width:145rpx;height:145rpx;border-radius:50%;background:#fff;box-shadow:0 8rpx 20rpx rgba(0,0,0,.12);margin:0 auto 18rpx;display:flex;align-items:center;justify-content:center;font-size:64rpx; }
.banner{width:100%;height:290rpx;border-radius:18rpx;margin:56rpx 0;display:block;}
.vip-row{display:flex;gap:34rpx;}
.vip-card{flex:1;height:155rpx;border-radius:14rpx;background:#7d84c6;color:#fff;display:flex;align-items:center;padding:0 28rpx;box-sizing:border-box;gap:20rpx;}
.vip-icon{font-size:60rpx;color:#ffe400}.big{font-size:32rpx}.small{font-size:18rpx;letter-spacing:1rpx;opacity:.9}
.store-tip{margin-top:30rpx;padding:26rpx}.store-name{font-weight:700;margin-bottom:10rpx}

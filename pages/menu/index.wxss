.menu-page{background:#fff}.top{padding:18rpx 28rpx 16rpx;background:#fff}.search{width:64rpx;height:64rpx;border:1rpx solid #e5e5e5;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#888;font-size:38rpx;margin-bottom:18rpx}.store-line{display:flex;justify-content:space-between;align-items:center}.store-name{font-weight:700;font-size:32rpx}.switch{display:flex;background:#f5f5f5;border-radius:38rpx;padding:5rpx;color:#999}.switch view{padding:10rpx 22rpx;border-radius:30rpx}.switch .active{background:#00875f;color:#fff;font-weight:700}.distance{color:#999;margin:22rpx 0}.notice{color:#999;display:flex;justify-content:space-between}
.content{display:flex;height:calc(100vh - 300rpx);border-top:1rpx solid #f2f2f2}.categories{width:170rpx;background:#f6f6f6}.cat{min-height:102rpx;padding:0 20rpx;display:flex;align-items:center;justify-content:center;text-align:center;color:#999;box-sizing:border-box}.cat.active{background:#fff;color:#222;font-weight:700;border-left:5rpx solid #00875f}.products{flex:1;padding-left:22rpx;box-sizing:border-box}.product{display:flex;padding:20rpx 22rpx 20rpx 0;gap:20rpx}.pimg{width:182rpx;height:182rpx;border-radius:12rpx;background:#eee;flex:none}.pinfo{flex:1;display:flex;flex-direction:column;min-width:0}.pname{font-weight:700;font-size:30rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.pdesc{color:#a5a5a5;font-size:22rpx;margin-top:10rpx;line-height:1.4}.pfoot{margin-top:auto;display:flex;align-items:center;justify-content:space-between}.yuan{font-size:20rpx}.price{font-size:30rpx}.from{color:#999;font-size:20rpx}.add{width:48rpx;height:48rpx;border-radius:50%;background:#00875f;color:#fff;display:flex;align-items:center;justify-content:center;font-size:38rpx}.add.sku{width:auto;height:48rpx;padding:0 18rpx;border-radius:24rpx;font-size:22rpx;font-weight:700}.bottom-space{height:220rpx}
.cartbar{position:fixed;left:35rpx;right:35rpx;bottom:132rpx;height:92rpx;border-radius:50rpx;background:#222;color:#fff;display:flex;align-items:center;z-index:900;box-shadow:0 8rpx 30rpx rgba(0,0,0,.18)}.bag{width:110rpx;text-align:center;font-size:44rpx;position:relative}.badge{position:absolute;right:12rpx;top:2rpx;background:#f45c5c;border-radius:20rpx;padding:1rpx 10rpx;font-size:18rpx}.cart-total{flex:1;font-weight:700;font-size:34rpx}.go{height:92rpx;line-height:92rpx;background:#00875f;border-radius:0 50rpx 50rpx 0;padding:0 34rpx}
.mask{position:fixed;z-index:1200;left:0;right:0;top:0;bottom:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-end}.sku-panel{width:100%;background:#fff;border-radius:28rpx 28rpx 0 0;padding:38rpx 32rpx 60rpx;box-sizing:border-box}.sku-title{font-size:34rpx;font-weight:700;margin-bottom:20rpx}.sku-row{padding:28rpx 0;border-bottom:1rpx solid #eee;display:flex;justify-content:space-between}.close{text-align:center;margin-top:30rpx;color:#888}

.menu-loading{height:calc(100vh - 300rpx);display:flex;align-items:center;justify-content:center;color:#999;background:#fafafa}.add.soldout{background:#c8c8c8;font-size:20rpx;width:auto;padding:0 14rpx}
